# Local development settings. Copy to .env and adjust; `make run-api` and `make run-worker` load it.
ECOGO_ENV=development
ECOGO_LOG_LEVEL=debug
ECOGO_DATABASE_URL=postgres://ecogo_app:ecogo_app@localhost:5432/ecogo
ECOGO_MIGRATION_DATABASE_URL=postgres://ecogo_owner:ecogo_owner@localhost:5432/ecogo
ECOGO_PUBLIC_APP_URL=http://localhost:5173
ECOGO_COOKIE_SECURE=false

# Generate each with: openssl rand -base64 32
ECOGO_MASTER_KEYS=1:REPLACE_WITH_32_RANDOM_BYTES_BASE64
ECOGO_APP_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# The staging Meta app (its own Meta Business portfolio). Configuration ID comes from
# Facebook Login for Business > Configurations, set up for WhatsApp Embedded Signup.
ECOGO_META_APP_ID=
ECOGO_META_APP_SECRET=
ECOGO_META_CONFIG_ID=
ECOGO_META_GRAPH_VERSION=v24.0
# Any random string; enter the same value as the Verify token on the Meta app's webhook page.
ECOGO_META_WEBHOOK_VERIFY_TOKEN=

# Mailpit from docker-compose catches mail at http://localhost:8025. Use Mailtrap settings on staging.
ECOGO_SMTP_HOST=localhost
ECOGO_SMTP_PORT=1025
ECOGO_MAIL_FROM="Ecogo WhatsApp <no-reply@ecogo.co.in>"

# Media files. With ECOGO_S3_ENDPOINT empty they go to ECOGO_MEDIA_DIR on local disk instead.
ECOGO_S3_ENDPOINT=localhost:9000
ECOGO_S3_ACCESS_KEY=minioadmin
ECOGO_S3_SECRET_KEY=minioadmin
ECOGO_S3_BUCKET=ecogo-media
ECOGO_S3_USE_SSL=false

# Billing (D9). Without keys the Billing tab shows plans but cannot take payment. Create the
# webhook in Razorpay pointing at https://<app domain>/webhooks/razorpay with the subscription.* events.
ECOGO_RAZORPAY_KEY_ID=
ECOGO_RAZORPAY_KEY_SECRET=
ECOGO_RAZORPAY_WEBHOOK_SECRET=

# GST invoices (D9): issued for each confirmed charge once the seller GSTIN is set. Plan prices
# include GST at this rate (basis points; 1800 = 18%).
ECOGO_SELLER_NAME=Ecogo Software Solutions Pvt Ltd
ECOGO_SELLER_GSTIN=
ECOGO_SELLER_ADDRESS=
ECOGO_SELLER_SAC=
ECOGO_GST_RATE_BP=1800

# AI agent (Phase 2): the language model behind chatbot answers. Without a key the AI step hands over to a person.
ECOGO_AI_PROVIDER=anthropic
ECOGO_AI_API_KEY=
ECOGO_AI_MODEL=claude-haiku-4-5-20251001
